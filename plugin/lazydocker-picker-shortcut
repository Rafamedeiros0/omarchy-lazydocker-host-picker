#!/usr/bin/env bash
set -euo pipefail

integration="$HOME/.local/bin/lazydocker-picker-integration"

case "${1:-}" in
  enable|disable|status)
    if [[ ! -x "$integration" ]]; then
      printf 'Shortcut integration manager is not installed: %s\n' "$integration" >&2
      exit 127
    fi
    exec "$integration" "$1"
    ;;
  "")
    ;;
  *)
    printf 'Usage: lazydocker-picker-shortcut [enable|disable|status]\n' >&2
    exit 2
    ;;
esac

exec omarchy-shell shell toggle rafamedeiros.lazydocker-host-picker '{}'
